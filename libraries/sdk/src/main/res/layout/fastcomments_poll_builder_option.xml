<?xml version="1.0" encoding="utf-8"?>
<!-- One editable option in the poll builder. The chip shape and the numbered hint are set in PollBuilderView. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="4dp"
    android:paddingEnd="10dp"
    android:paddingBottom="4dp">

    <View
        android:id="@+id/pollBuilderOptionMark"
        android:layout_width="18dp"
        android:layout_height="18dp" />

    <EditText
        android:id="@+id/pollBuilderOptionInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:background="@null"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textColor="@color/fastcomments_poll_chip_text"
        android:textColorHint="@color/fastcomments_poll_text_muted"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:ignore="LabelFor" />

    <TextView
        android:id="@+id/pollBuilderOptionRemove"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginStart="12dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/fastcomments_poll_remove_option"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/fastcomments_poll_close_symbol"
        android:textColor="@color/fastcomments_poll_text_muted"
        android:textSize="18sp" />
</LinearLayout>
